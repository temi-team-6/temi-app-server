POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
TEMI_TOKEN=dev-temi-token
PI_TOKEN=dev-pi-token
CORS_ORIGINS=*
API_PORT=8000
SAY_DONE_TIMEOUT_S=20
READY_TIMEOUT_S=10
READY_PROMPTS=2
LEAD_IN_S=2
# Claude API 키. 비워 두면 LLM을 부르지 않고 규칙 응답만 쓴다.
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5
# 검사 중 판단과 Temi 대사를 Claude가 맡는다(app/agent/ai.py). false면 규칙만 쓴다. 판단 한 번을 기다리는 최대 초.
AGENT_AI_ENABLED=true
AGENT_AI_TIMEOUT_S=6
# Google Gemini API 키(음성 받아 적기, app/stt.py). 비워 두면 받아 적지 않고 Pi가 보낸 word_count만 쓴다.
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.6-flash
# 트윈(/twin/)의 시나리오·가상 기기 제어. 시연 당일에는 false
TWIN_ENABLED=true
TUNNEL_TOKEN=
